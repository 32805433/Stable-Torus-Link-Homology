import TorusLinkHomology.Generation.AuxiliaryStatement
import TorusLinkHomology.Generation.Connecting

/-! # Generation and the two comparison maps

These are the tail-lifting and exceptional-index steps of the induction.
They do not assume the unfinished generation theorem.
-/

noncomputable section

namespace TorusLinkHomology.CoefficientComplex

/-- In the induction range the comparison maps the new tail algebra onto
the middle tail algebra, with the prescribed generators on both sides. -/
theorem J_tailSubalgebra (N r ell : ℕ) (hell : ell ≤ N * r) :
    (tailSubalgebra N r ell).map (J N r ell) = tailSubalgebra N r (ell - 1) := by
  unfold tailSubalgebra
  rw [AlgHom.map_adjoin]
  congr 1
  ext a
  constructor
  · rintro ⟨b, ⟨j, hj, hNr, rfl⟩, rfl⟩
    exact ⟨j, by omega, hNr, J_tail N r ell j hj⟩
  · rintro ⟨j, _, hNr, rfl⟩
    refine ⟨tail N r ell j, ⟨j, by omega, hNr, rfl⟩, ?_⟩
    exact J_tail N r ell j (by omega)

/-- Generation at the preceding offset lifts every middle homology class
using an element of the new tail algebra. -/
theorem exists_tail_lift_mod_boundary (N r ell : ℕ) (hell : ell ≤ N * r)
    (hgen : TailGeneration N r (ell - 1)) (z : A r) (hz : d N r ell z = 0) :
    ∃ v : A r, v ∈ tailSubalgebra N r ell ∧ ∃ w : A r,
      J N r ell (z - v) = d N r (ell - 1) w := by
  obtain ⟨p, hp, w, hw⟩ := hgen (J N r ell z) (J_cycle N r ell hz)
  rw [← J_tailSubalgebra N r ell hell, Subalgebra.mem_map] at hp
  obtain ⟨v, hv, hJv⟩ := hp
  refine ⟨v, hv, w, ?_⟩
  rw [map_sub, hJv, hw, add_sub_cancel_left]

/-- Reduction takes every new tail expression into the old tail algebra. -/
theorem rhoSucc_mem_tailSubalgebra (N r ell : ℕ) (a : A (r + 1))
    (ha : a ∈ tailSubalgebra N (r + 1) ell) :
    rhoSucc N r ell a ∈ tailSubalgebra N r ell := by
  induction ha using Algebra.adjoin_induction with
  | mem a ha =>
    obtain ⟨j, hj, hNr, rfl⟩ := ha
    rw [rhoSucc_tail N r ell j hj]
    apply tail_mem_tailSubalgebra _ _ _ _ hj
    have : N * r ≤ N * (r + 1) := Nat.mul_le_mul_left N (by omega)
    omega
  | algebraMap c =>
    rw [rhoSucc_algebraMap]
    exact (tailSubalgebra N r ell).algebraMap_mem _
  | add x y _ _ hx hy =>
    rw [map_add]
    exact (tailSubalgebra N r ell).add_mem hx hy
  | mul x y _ _ hx hy =>
    rw [map_mul]
    exact (tailSubalgebra N r ell).mul_mem hx hy

/-- The size of the exceptional interval is the minimum of `N` and the
remaining degree deficit. -/
theorem exceptional_threshold (N r ell : ℕ) (hell : ell ≤ N * (r + 1)) :
    N * (r + 1) - min N (N * (r + 1) - ell) = max ell (N * r) := by
  simp only [Nat.mul_add, Nat.mul_one] at *
  omega

/-- The finite exceptional old tails, indexed by their deficits. -/
def exceptionalTails (N r ell : ℕ) : Set (A r) :=
  {a | ∃ t : ℕ, t < min N (N * (r + 1) - ell) ∧
    a = tail N r ell (N * (r + 1) - t)}

/-- The other old generators are reductions of new tail expressions. -/
def reducedTailExpressions (N r ell : ℕ) : Set (A r) :=
  {a | ∃ b : A (r + 1), b ∈ tailSubalgebra N (r + 1) ell ∧
    a = rhoSucc N r ell b}

/-- Every old tail expression is generated by the exceptional tails and
reductions of new tail expressions. The reverse inclusion also holds. -/
theorem old_tailSubalgebra_eq_adjoin (N r ell : ℕ) (hell : ell ≤ N * (r + 1)) :
    tailSubalgebra N r ell = Algebra.adjoin (R r)
      (exceptionalTails N r ell ∪ reducedTailExpressions N r ell) := by
  have hthreshold := exceptional_threshold N r ell hell
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro a ⟨j, hj, hNr, rfl⟩
    apply Algebra.subset_adjoin
    by_cases hjtop : j ≤ N * (r + 1)
    · left
      refine ⟨N * (r + 1) - j, ?_, ?_⟩
      · omega
      · congr 1
        omega
    · right
      refine ⟨tail N (r + 1) ell j,
        tail_mem_tailSubalgebra _ _ _ _ hj (by omega), ?_⟩
      exact (rhoSucc_tail N r ell j hj).symm
  · apply Algebra.adjoin_le
    intro a ha
    rcases ha with ⟨t, ht, rfl⟩ | ⟨b, hb, rfl⟩
    · apply tail_mem_tailSubalgebra
      · omega
      · omega
    · exact rhoSucc_mem_tailSubalgebra N r ell b hb

/-- Once all connecting classes have tail representatives, generation in
the middle complex implies generation in the new complex. This is the
representative-level exactness step of the induction; exceptional-transfer
arguments must still establish its connecting-class hypothesis. -/
theorem tailGeneration_of_connecting (N r ell : ℕ)
    (hm : ell + 1 < N * (r + 1)) (hgen : TailGeneration N (r + 1) ell)
    (hconnecting : ∀ a : A r, d N r (ell + 1) a = 0 →
      ∀ z : A (r + 1), ConnectingRepresentative N r ell a z →
        ∃ s : A (r + 1), s ∈ tailSubalgebra N (r + 1) (ell + 1) ∧
          ∃ b : A (r + 1), z = s + d N (r + 1) (ell + 1) b) :
    TailGeneration N (r + 1) (ell + 1) := by
  intro z hz
  obtain ⟨v, hv, w, hw⟩ := exists_tail_lift_mod_boundary N (r + 1) (ell + 1)
    (Nat.le_of_lt hm) (by simpa only [Nat.add_sub_cancel_right] using hgen) z hz
  have hw' : J N (r + 1) (ell + 1) (z - v) = d N (r + 1) ell w := by
    simpa only [Nat.add_sub_cancel_right] using hw
  obtain ⟨a, ha, hza⟩ := (exists_connectingRepresentative_iff N r ell (z - v)).mpr ⟨w, hw'⟩
  obtain ⟨s, hs, b, hb⟩ := hconnecting a ha (z - v) hza
  refine ⟨v + s, (tailSubalgebra N (r + 1) (ell + 1)).add_mem hv hs, b, ?_⟩
  calc
    z = v + (z - v) := by abel
    _ = v + s + d N (r + 1) (ell + 1) b := by rw [hb, add_assoc]

end TorusLinkHomology.CoefficientComplex
