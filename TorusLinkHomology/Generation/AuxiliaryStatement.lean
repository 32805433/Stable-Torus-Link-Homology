import TorusLinkHomology.Generation.CoefficientComplex

/-! # Auxiliary generation and its induction base cases -/

noncomputable section

namespace TorusLinkHomology.CoefficientComplex

/-- The coefficient subalgebra generated by every designated closed tail. -/
def tailSubalgebra (N r ell : ℕ) : Subalgebra (R r) (A r) :=
  Algebra.adjoin (R r)
    {a | ∃ j : ℕ, ell < j ∧ N * r < j ∧ a = tail N r ell j}

/-- The auxiliary generation claim expressed on cycle representatives. -/
def TailGeneration (N r ell : ℕ) : Prop :=
  ∀ z : A r, d N r ell z = 0 →
    ∃ p : A r, p ∈ tailSubalgebra N r ell ∧ ∃ b : A r, z = p + d N r ell b

theorem tail_mem_tailSubalgebra (N r ell j : ℕ) (hj : ell < j) (hNr : N * r < j) :
    tail N r ell j ∈ tailSubalgebra N r ell :=
  Algebra.subset_adjoin ⟨j, hj, hNr, rfl⟩

/-- All elements of the generated subalgebra really are cycles. -/
theorem tailSubalgebra_le_cycles (N r ell : ℕ) :
    tailSubalgebra N r ell ≤ (dga N r ell).cycles := by
  apply Algebra.adjoin_le
  rintro a ⟨j, hj, hNr, rfl⟩
  exact tail_is_cycle N r ell j hj hNr

/-- Above the polynomial degree bound, the initial generators are all tails. -/
theorem tailSubalgebra_eq_top_of_le (N r ell : ℕ) (hell : N * r ≤ ell) :
    tailSubalgebra N r ell = ⊤ := by
  apply Algebra.eq_top_iff.mpr
  intro x
  have hxi (i : Fin r) : xi r i ∈ tailSubalgebra N r ell := by
    rw [← tail_initial N r ell i]
    exact tail_mem_tailSubalgebra _ _ _ _ (by omega) (by omega)
  induction x using ExteriorAlgebra.induction with
  | algebraMap c => exact (tailSubalgebra N r ell).algebraMap_mem c
  | ι m =>
    have hm : (∑ i : Fin r, m i • Finsupp.single i (1 : R r)) = m :=
      (Finsupp.basisSingleOne : Module.Basis (Fin r) (R r) (V r)).sum_repr m
    rw [← hm, map_sum]
    apply Subalgebra.sum_mem
    intro i _
    rw [map_smul]
    exact (tailSubalgebra N r ell).smul_mem (hxi i) _
  | mul x y hx hy => exact (tailSubalgebra N r ell).mul_mem hx hy
  | add x y hx hy => exact (tailSubalgebra N r ell).add_mem hx hy

theorem tailGeneration_of_le (N r ell : ℕ) (hell : N * r ≤ ell) :
    TailGeneration N r ell := by
  intro z _
  refine ⟨z, ?_, 0, by simp⟩
  rw [tailSubalgebra_eq_top_of_le N r ell hell]
  trivial

theorem tailGeneration_zero_rank (N ell : ℕ) : TailGeneration N 0 ell :=
  tailGeneration_of_le N 0 ell (by simp)

/-- In the nontrivial induction range, the infinite tail family generates
the same subalgebra as its specified finite initial list. -/
theorem tailSubalgebra_eq_adjoin_finite (N r ell : ℕ) (hell : ell < N * r) :
    tailSubalgebra N r ell = Algebra.adjoin (R r)
      {a | ∃ j : ℕ, N * r < j ∧ j < (N + 1) * r ∧ a = tail N r ell j} := by
  let S : Subalgebra (R r) (A r) := Algebra.adjoin (R r)
    {a | ∃ j : ℕ, N * r < j ∧ j < (N + 1) * r ∧ a = tail N r ell j}
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro a ⟨j, _, hj, rfl⟩
    have hspan : finiteTailSpan N r ell ≤ S.toSubmodule := by
      apply Submodule.span_le.mpr
      exact fun _ ha => Algebra.subset_adjoin ha
    exact hspan (tail_mem_finiteTailSpan N r ell j hell hj)
  · apply Algebra.adjoin_le
    rintro a ⟨j, hj, _, rfl⟩
    exact tail_mem_tailSubalgebra _ _ _ _ (hell.trans hj) hj

end TorusLinkHomology.CoefficientComplex
