import TorusLinkHomology.Generation.UniversalJetEvaluation
import TorusLinkHomology.Generation.UniversalTransferNoV
import TorusLinkHomology.Generation.AuxiliaryStatement

/-!
# Evaluation of the universal polynomial on the closed P coefficients

This file connects the finite universal jet expression with the free cycle
algebra, coefficient independence, the Q=0 comparison, and the actual algebra
generated by tail cycles after specialization.
-/

noncomputable section

open scoped BigOperators

namespace TorusLinkHomology.UniversalTransfer

/-- Every coefficient of the universal polynomial evaluated on P is closed. -/
theorem jetExpression_pSeries_coeff_is_cycle (N m r ell : ℕ)
    (hN : 0 < N) (hbound : N * r = ell + m)
    (c : Finset (Fin (N + 1)) → TorusLinkHomology.R (N + 1)) (i : ℕ) :
    d N m ((UniversalJets.jetExpression N c (r : ℤ) (((N + 1) * r : ℕ) : ℤ)
      ySeries (pSeries N m r)).coeff i) = 0 := by
  exact UniversalJets.jetExpression_coeff_mem (dga N m).cycles N c _ _ ySeries
    (pSeries N m r) (fun j => pSeries_coeff_is_cycle N m r ell j hN hbound) i

/-- Coefficients of the evaluated universal polynomial remain independent of v. -/
theorem noVSeries_jetExpression_pSeries (N m r : ℕ)
    (c : Finset (Fin (N + 1)) → TorusLinkHomology.R (N + 1)) :
    NoVSeries (UniversalJets.jetExpression N c (r : ℤ) (((N + 1) * r : ℕ) : ℤ)
      ySeries (pSeries N m r)) := by
  apply UniversalJets.jetExpression_mem_coeffSubalgebra noVSubalgebra N c _ _ ySeries
    (pSeries N m r)
  · intro s
    exact UniversalJets.evenJetMap_mem_coeffSubalgebra noVSubalgebra (N + 1) (r : ℤ)
      ySeries noVSeries_scalar_ySeries (c s)
  · exact noVSeries_pSeries N m r

@[simp] theorem eraseQ_scalarSeries (F : PowerSeries R) :
    PowerSeries.map eraseQ.toRingHom (scalarSeries F) = scalarSeries F := by
  ext i
  simp only [scalarSeries, PowerSeries.coeff_map]
  exact eraseQ.commutes (F.coeff i)

@[simp] theorem eraseQ_cSeries : PowerSeries.map eraseQ.toRingHom cSeries = cSeries := by
  ext i
  simp only [PowerSeries.coeff_map, cSeries, PowerSeries.coeff_mk]
  exact eraseQ_oddA i

@[simp] theorem eraseQ_qSeries : PowerSeries.map eraseQ.toRingHom qSeries = 0 := by
  ext i
  simp only [PowerSeries.coeff_map, qSeries, PowerSeries.coeff_mk, map_zero]
  exact eraseQ_oddQ i

@[simp] theorem eraseQ_sSeries_cSeries (N r : ℕ) :
    PowerSeries.map eraseQ.toRingHom (sSeries N r cSeries) = sSeries N r cSeries := by
  rw [sSeries, CoefficientSeries.map_expression, eraseQ_scalarSeries, eraseQ_cSeries]

/-- Setting Q=0 leaves exactly the negative Euler expression. -/
theorem eraseQ_pSeries (N m r : ℕ) :
    PowerSeries.map eraseQ.toRingHom (pSeries N m r) = -sSeries N r cSeries := by
  rw [pSeries, map_sub, map_nsmul, map_mul, eraseQ_qSeries, mul_zero, smul_zero,
    zero_sub, eraseQ_sSeries_cSeries]

/-- The exterior-degree support of the finite coefficients gives the exact
sign under the Q=0 comparison. -/
theorem eraseQ_jetExpression_pSeries (N m r q : ℕ)
    (c : Finset (Fin (N + 1)) → TorusLinkHomology.R (N + 1))
    (hc : ∀ s, s.card ≠ q → c s = 0) :
    PowerSeries.map eraseQ.toRingHom
      (UniversalJets.jetExpression N c (r : ℤ) (((N + 1) * r : ℕ) : ℤ)
        ySeries (pSeries N m r)) =
      ((-1 : ℤ) ^ q) •
        UniversalJets.jetExpression N c (r : ℤ) (((N + 1) * r : ℕ) : ℤ)
          ySeries (sSeries N r cSeries) := by
  rw [UniversalJets.map_jetExpression (RingHom.id R) eraseQ.toRingHom
    (fun a => eraseQ.commutes a), PowerSeries.map_id, eraseQ_pSeries]
  exact UniversalJets.jetExpression_neg N q c hc _ _ ySeries (sSeries N r cSeries)

/-- The same comparison as an identity in the actual free chain algebra. -/
theorem eraseQ_jetExpression_pSeries_coeff (N m r q : ℕ)
    (c : Finset (Fin (N + 1)) → TorusLinkHomology.R (N + 1))
    (hc : ∀ s, s.card ≠ q → c s = 0) (i : ℕ) :
    eraseQ ((UniversalJets.jetExpression N c (r : ℤ) (((N + 1) * r : ℕ) : ℤ)
      ySeries (pSeries N m r)).coeff i) =
      ((-1 : ℤ) ^ q) •
        ((UniversalJets.jetExpression N c (r : ℤ) (((N + 1) * r : ℕ) : ℤ)
          ySeries (sSeries N r cSeries)).coeff i) := by
  have h := congrArg (fun F : PowerSeries A => F.coeff i)
    (eraseQ_jetExpression_pSeries N m r q c hc)
  rw [PowerSeries.coeff_map, map_zsmul] at h
  exact h

end TorusLinkHomology.UniversalTransfer

namespace TorusLinkHomology.UniversalTransferSpecialization

open CoefficientComplex

/-- The finite span of designated tails is contained in the tail algebra. -/
theorem finiteTailSpan_le_tailSubalgebra (N r ell : ℕ) (hell : ell < N * r) :
    finiteTailSpan N r ell ≤ (tailSubalgebra N r ell).toSubmodule := by
  apply Submodule.span_le.mpr
  rintro a ⟨j, hj, _, rfl⟩
  exact tail_mem_tailSubalgebra N r ell j (hell.trans hj) hj

/-- Every specialized universal polynomial coefficient is an actual polynomial
in the designated tail cycles, before passing to homology. -/
theorem specialize_jetExpression_pSeries_coeff_mem_tailSubalgebra
    (N m r ell : ℕ) (hN : 0 < N) (hm : 0 < m) (hbound : N * r = ell + m)
    (c : Finset (Fin (N + 1)) → TorusLinkHomology.R (N + 1)) (i : ℕ) :
    specialize N r ell
      ((UniversalJets.jetExpression N c (r : ℤ) (((N + 1) * r : ℕ) : ℤ)
        UniversalTransfer.ySeries (UniversalTransfer.pSeries N m r)).coeff i) ∈
      tailSubalgebra N r ell := by
  have hn := UniversalJets.map_jetExpression (evenMap N r ell).toRingHom (specialize N r ell)
    (fun a => specialize_scalar N r ell a) N c (r : ℤ) (((N + 1) * r : ℕ) : ℤ)
    UniversalTransfer.ySeries (UniversalTransfer.pSeries N m r)
  have hc := congrArg (fun F : PowerSeries (A r) => F.coeff i) hn
  rw [PowerSeries.coeff_map] at hc
  rw [hc]
  apply UniversalJets.jetExpression_coeff_mem (tailSubalgebra N r ell)
  intro j
  rw [PowerSeries.coeff_map]
  exact finiteTailSpan_le_tailSubalgebra N r ell (by omega)
    (specialize_pSeries_coeff_mem_finiteTailSpan N m r ell j hN hm hbound)

end TorusLinkHomology.UniversalTransferSpecialization
