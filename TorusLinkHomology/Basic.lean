import Mathlib.LinearAlgebra.CliffordAlgebra.Contraction

/-!
# The coefficient Koszul algebra and its named one-cycles

The coefficient ring is `ℚ[u₀, ..., u_{n-1}]`. The differential on its
exterior algebra is contraction with the coefficients of `u(z)^N`.
This module contains definitions and elementary facts, independently of
the homology-generation theorem.
-/

noncomputable section

open scoped BigOperators

namespace TorusLinkHomology

/-- The coefficient ring ℚ[u₀, ..., u_{n-1}]. -/
abbrev R (n : ℕ) := MvPolynomial (Fin n) ℚ

/-- The free R-module with basis corresponding to ξ₀, ..., ξ_{n-1}. -/
abbrev V (n : ℕ) := Fin n →₀ R n

/-- The underlying algebra of A_{N,n}; N only affects its differential. -/
abbrev A (n : ℕ) := ExteriorAlgebra (R n) (V n)

/-- The even polynomial generator u_i. -/
def u (n : ℕ) (i : Fin n) : R n := MvPolynomial.X i

/-- The polynomial u(z) = ∑_{i=0}^{n-1} u_i z^i. -/
def uPolynomial (n : ℕ) : Polynomial (R n) :=
  ∑ i : Fin n, Polynomial.monomial i.val (u n i)

/-- The coefficient [z^i]u(z)^N. -/
def differentialCoefficient (N n : ℕ) (i : Fin n) : R n :=
  ((uPolynomial n) ^ N).coeff i.val

/-- The odd generator ξ_i, of Koszul degree 1. -/
def xi (n : ℕ) (i : Fin n) : A n :=
  ExteriorAlgebra.ι (R n) (Finsupp.single i 1)

/-- The R-linear functional specifying the Koszul differential. -/
def differentialFunctional (N n : ℕ) : V n →ₗ[R n] R n :=
  Finsupp.linearCombination (R n) (differentialCoefficient N n)

/-- The differential on the entire exterior algebra, not just its generators. -/
def d (N n : ℕ) : A n →ₗ[R n] A n :=
  CliffordAlgebra.contractLeft (Q := 0) (differentialFunctional N n)

/-- The differential squares to zero. -/
theorem d_squared (N n : ℕ) (a : A n) : d N n (d N n a) = 0 := by
  exact CliffordAlgebra.contractLeft_contractLeft (differentialFunctional N n) a

/-- All polynomial coefficients, in particular the u_i, are closed. -/
@[simp] theorem d_scalar (N n : ℕ) (r : R n) :
    d N n (algebraMap (R n) (A n) r) = 0 := by
  exact CliffordAlgebra.contractLeft_algebraMap _ _ r

/-- The defining formula dξ_i = [z^i]u(z)^N. -/
@[simp] theorem d_xi (N n : ℕ) (i : Fin n) :
    d N n (xi n i) =
      algebraMap (R n) (A n) (differentialCoefficient N n i) := by
  simp [d, xi, differentialFunctional]

/-- The signed Leibniz rule when the first factor is an odd generator. -/
theorem d_xi_mul (N n : ℕ) (i : Fin n) (a : A n) :
    d N n (xi n i * a) =
      differentialCoefficient N n i • a - xi n i * d N n a := by
  simpa [d, xi, differentialFunctional] using
    (CliffordAlgebra.contractLeft_ι_mul (differentialFunctional N n)
      (Finsupp.single i 1) a)

/-- The homogeneous component of Koszul degree p. -/
abbrev koszulDegree (n p : ℕ) : Submodule (R n) (A n) :=
  ExteriorAlgebra.exteriorPower (R n) p (V n)

/-- μ_k = ∑_{i+j=k} (Ni-j)u_i ξ_j.

The subtraction is in R, not in ℕ, so negative coefficients are preserved.
Only 1 ≤ k < n are used in the conjecture.
-/
def mu (N n k : ℕ) : A n :=
  ∑ i : Fin n, ∑ j : Fin n,
    if i.val + j.val = k then
      (((N : R n) * (i.val : R n) - (j.val : R n)) * u n i) • xi n j
    else 0

/-- Every μ_k is homogeneous of Koszul degree 1 (including when it is zero). -/
theorem mu_mem_degree_one (N n k : ℕ) : mu N n k ∈ koszulDegree n 1 := by
  unfold mu
  apply Submodule.sum_mem
  intro i _
  apply Submodule.sum_mem
  intro j _
  split_ifs
  · apply Submodule.smul_mem
    change xi n j ∈ LinearMap.range (ExteriorAlgebra.ι (R n)) ^ 1
    rw [pow_one]
    exact ⟨Finsupp.single j 1, rfl⟩
  · exact Submodule.zero_mem _

/-- The R-subalgebra of A generated by μ₁, ..., μ_{n-1}.

`Algebra.adjoin` includes all polynomial coefficients from R and permits
finite sums and products of the generators. For n = 1 the generator set
is empty, so this is just the image of R.
-/
def muSubalgebra (N n : ℕ) : Subalgebra (R n) (A n) :=
  Algebra.adjoin (R n) {a | ∃ k : ℕ, 1 ≤ k ∧ k < n ∧ a = mu N n k}

end TorusLinkHomology
